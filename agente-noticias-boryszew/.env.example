# Configura estas variables en el entorno; este archivo no se carga automáticamente.
# No guardes la clave real en el repositorio.
NEWS_LLM_API_KEY=
NEWS_LLM_MODEL=gpt-4o-mini
# Opcional: RSS 2.0 públicos adicionales, separados por comas, con URLs HTTPS.
NEWS_RSS_URLS=
# Por defecto solo acceso local. Usa un proxy con HTTPS y autenticación para publicar.
NEWS_HOST=127.0.0.1
PORT=8000
